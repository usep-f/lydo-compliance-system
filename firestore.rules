rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper to check if user has admin role in 'users' collection
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper to get the user's barangay
    function getUserBarangay() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.barangay;
    }

    // Pending Users: Applicants can write, only Admins can read or delete
    match /pending_users/{applicationId} {
      // Anyone can submit an application, but only with the expected fields.
      // This prevents injection of arbitrary fields (e.g. role, status spoofing)
      // and limits junk-data flooding to only structurally valid documents.
      allow create: if request.resource.data.keys().hasOnly([
                        'fullName', 'email', 'barangay', 'proofStoragePath', 'submittedAt'
                      ])
                      && request.resource.data.fullName is string
                      && request.resource.data.email is string
                      && request.resource.data.barangay is string
                      && request.resource.data.proofStoragePath is string
                      && request.resource.data.submittedAt is timestamp;

      allow read, delete: if isAdmin();
      allow update: if false; // Applications cannot be tampered with after submission
    }

    // Approved Users: All authenticated users can read profile data for directory modal
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ── Pending Submissions ──
    // Users create submissions for themselves; admins read/delete via Cloud Functions
    match /pending_submissions/{submissionId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.barangay == getUserBarangay()
        && request.resource.data.keys().hasOnly([
             'userId', 'barangay', 'fullName', 'category',
             'documentType', 'documentLabel', 'period', 'year',
             'accomplishmentCategory', 'fileStoragePath', 'fileName', 
             'fileSize', 'pageCount', 'pdfMetadata', 'submittedAt'
           ])
        && request.resource.data.category in ['scheduled', 'asap', 'perennial']
        && request.resource.data.userId is string
        && request.resource.data.barangay is string
        && request.resource.data.fullName is string
        && request.resource.data.documentType is string
        && request.resource.data.documentLabel is string
        && request.resource.data.period is string
        && request.resource.data.year is number
        && request.resource.data.fileStoragePath is string
        && request.resource.data.fileStoragePath.matches('^submission_files/' + request.auth.uid + '/.*')
        && request.resource.data.fileName is string
        && request.resource.data.fileSize is number
        && request.resource.data.fileSize <= 104857600
        && request.resource.data.pageCount is number
        && request.resource.data.pdfMetadata is map
        && request.resource.data.submittedAt is timestamp
        && (!('accomplishmentCategory' in request.resource.data.keys()) || request.resource.data.accomplishmentCategory is string)
        && (!exists(/databases/$(database)/documents/submissions/$(submissionId)) || get(/databases/$(database)/documents/submissions/$(submissionId)).data.status == 'denied');

      // Secured: Limit read access to authorized owners, barangay peers, and admins
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.barangay == getUserBarangay() ||
        isAdmin()
      );

      // No client-side updates — prevents tampering after submission
      allow update: if false;

      // Only admins (via Cloud Functions) delete
      allow delete: if isAdmin();
    }

    // ── Approved Submissions ──
    // Written exclusively by Cloud Functions (Admin SDK bypasses rules).
    // Client-side writes are fully blocked.
    match /submissions/{submissionId} {
      // Secured: Limit read access to authorized owners, barangay peers, and admins
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.barangay == getUserBarangay() ||
        isAdmin()
      );

      // No direct client writes — only Cloud Functions can write here
      allow write: if false;
    }

    // ── Perennial Counts ──
    // Users can create/update their own; admins can read all
    match /perennial_counts/{docId} {
      allow create, update: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.barangay == getUserBarangay()
        && request.resource.data.keys().hasOnly([
             'userId', 'barangay', 'fullName', 'year',
             'resolutions', 'accomplishmentReports', 'updatedAt'
           ])
        && request.resource.data.userId is string
        && request.resource.data.barangay is string
        && request.resource.data.fullName is string
        && request.resource.data.year is number
        && request.resource.data.resolutions is number
        && request.resource.data.resolutions >= 0
        && request.resource.data.accomplishmentReports is number
        && request.resource.data.accomplishmentReports >= 0
        && request.resource.data.updatedAt is timestamp;

      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid || resource.data.barangay == getUserBarangay() || isAdmin());

      allow delete: if false;
    }

    // ── Notifications ──
    // Each user has a subcollection of their own notification items.
    // Cloud Functions (Admin SDK) create and delete; clients can only read
    // and mark as read (update isRead field only).
    match /notifications/{userId}/items/{notifId} {
      // Only the notification owner can read their notifications
      allow read: if request.auth != null && request.auth.uid == userId;

      // Clients can only set isRead to true — no other fields can be changed
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
        && request.resource.data.isRead == true;

      // All creates and deletes are handled by Cloud Functions via Admin SDK
      allow create, delete: if false;
    }

    // ── Two-Factor Authentication ──
    // Challenges are strictly backend-only. Clients cannot read or write them directly.
    match /twoFactorChallenges/{challengeId} {
      allow read, write: if false; 
    }

    // ── CMS Bulletins ──
    // Guests can read bulletins; only admins can write
    match /cms_bulletins/{bulletinId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Global System Settings ──
    // Guests/users can read settings; only admins can write
    match /settings/{settingsId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}