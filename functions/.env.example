# Brevo API Key for sending transactional emails (Approval / Rejection)
# Get your API key from SMTP & API page: https://brevo.com/settings/keys
BREVO_API_KEY=
# The verified personal email you registered in Brevo as a sender
# Verify your email under Senders & IPs: https://brevo.com/senders
BREVO_SENDER_EMAIL=
