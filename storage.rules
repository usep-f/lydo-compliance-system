rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper to check if user has admin role
    function isAdmin() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper to get the user's barangay from Firestore
    function getUserBarangay(uid) {
      return firestore.get(/databases/(default)/documents/users/$(uid)).data.barangay;
    }

    match /temp_proofs/{filename} {
      // Allow unauthenticated uploads for registration, but enforce:
      // - Hard 50 MB file size limit
      // - Only images and PDFs accepted
      allow create: if request.resource.size < 50 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*|application/pdf');

      // Prevent tampering/modification of registration proofs once submitted
      allow update: if false;

      // Secured: Only authenticated admins can read or delete proof files
      allow read, delete: if request.auth != null && isAdmin();
    }

    // ── User Avatars ──
    match /avatars/{userId}/{allPaths=**} {
      allow create: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow update: if false;
      allow read: if request.auth != null;
      allow delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // ── Submission Files ──
    // Users upload PDFs under their own userId path.
    // Only PDF format, max 100 MB.
    match /submission_files/{userId}/{allPaths=**} {
      // Upload: authenticated owner only, PDF only, 100 MB cap
      allow create: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 100 * 1024 * 1024
                   && request.resource.contentType == 'application/pdf';

      // Secured: Prevent users from overwriting or updating their files post-upload
      allow update: if false;

      // Read: owner, anyone in the same barangay, or admin
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        isAdmin() ||
        getUserBarangay(request.auth.uid) == getUserBarangay(userId)
      );

      // Delete: only admins (via Cloud Functions for denied submissions)
      allow delete: if request.auth != null && isAdmin();
    }

    // All other storage paths are denied by default.
    // No wildcard rule — unlisted paths are implicitly blocked.
  }
}
