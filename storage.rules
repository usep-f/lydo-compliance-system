rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    match /temp_proofs/{filename} {
      // Allow unauthenticated uploads for registration, but enforce:
      // - Hard 50 MB file size limit
      // - Only images and PDFs accepted
      allow write: if request.resource.size < 50 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*|application/pdf');

      // Only authenticated users (admins) can read or delete proof files
      allow read, delete: if request.auth != null;
    }

    // All other storage paths are denied by default.
    // No wildcard rule — unlisted paths are implicitly blocked.
  }
}
